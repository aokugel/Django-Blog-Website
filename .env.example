# Copy to .env (repo root) and fill in. The .env file is gitignored and never baked into images.

# --- Required in production ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Comma-separated. Default: localhost,127.0.0.1
ALLOWED_HOSTS=anthonykugel.com,www.anthonykugel.com
# Directory collectstatic writes to; must match nginx's `location /static/` alias. Default: ./staticfiles
STATIC_ROOT=/var/www/static
# Secure cookies and HSTS. Set to 1 in production (served over HTTPS); leave unset locally.
HTTPS=1

# --- Database (defaults shown match the local docker-compose Postgres) ---
DB_NAME=djangodb
DB_USERNAME=djangodb_user
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Optional ---
# Set to 1 for local development only. Default: off.
# With DEBUG=1, SECRET_KEY falls back to an insecure dev key if unset.
DEBUG=
